# Safe local preview. Never commit your real .env.
HOST=127.0.0.1
PORT=8000
ENABLE_DEMO=true
MODEL_PROVIDER=unconfigured
MODEL_NAME=demo
MODEL_NAMES=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# For live mode set ENABLE_DEMO=false, MODEL_PROVIDER and exact model IDs.
# Prices are USD per million tokens; copy current provider prices for each model.
MODEL_PRICES_JSON={}
MAX_STEPS=6
MAX_TOOL_RETRIES=2
MAX_CONTRACT_RETRIES=2
MAX_OUTPUT_TOKENS=1024
MAX_RUN_TOKENS=60000
MAX_RUN_COST_USD=0.05
RUN_TIMEOUT_SECONDS=40
MODEL_TIMEOUT_SECONDS=15
TOOL_TIMEOUT_SECONDS=2
HISTORY_MESSAGES=12
HISTORY_CHARS=24000
MAX_CONTEXT_BYTES=32000
MAX_SESSIONS=100
MAX_CONCURRENT_RUNS=2
REQUESTS_PER_MINUTE=30
MAX_DAILY_MODEL_CALLS=200

